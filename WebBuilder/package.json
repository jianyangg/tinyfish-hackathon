{
  "name": "webbuilder-codex-streamer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild public/app.ts --bundle --format=esm --target=es2020 --outfile=public/app.js",
    "build": "npm run build:client && tsc -p tsconfig.json",
    "dev": "npm run build:client && tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
